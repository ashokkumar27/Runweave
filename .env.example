# Placeholders only. Choose your own API authentication key.
API_KEY=replace-with-a-long-random-local-api-key
DATABASE_URL=postgresql+asyncpg://agents:local-development-only@localhost:5432/agents
DATABASE_SCHEMA=public
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=agents-v1
MAX_ACTIVE_RUNS=20
MCP_URL=http://localhost:8001/mcp
# Optional providers: default fake-model tests need neither credential.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional OTLP HTTP collector base URL; no external telemetry by default.
OTEL_EXPORTER_OTLP_ENDPOINT=
PYDANTIC_AI_NO_BANNER=1
